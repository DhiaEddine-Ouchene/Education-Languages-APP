generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDUCATOR
  STUDENT
}

enum Plan {
  FREE
  PRO
  ULTIMATE
}

enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum GameType {
  FLASHCARD
  FILL_BLANK
  DRAG_DROP
  QUIZ
  DICTATION
  MEMORY
  SPEED_ROUND
  STORY

  // Vocabulary
  SYNONYM_ANTONYM
  FILL_GAP_WORD
  SITUATION_DIALOGUE_FILL
  WORD_SCRAMBLE
  CATEGORY_SORT
  WORD_MEANING_MATCH
  WORD_IN_CONTEXT
  ODD_ONE_OUT
  COLLOCATION_BUILDER

  // Grammar
  SENTENCE_BUILDER
  ERROR_SPOTTING
  FILL_BLANK_GRAMMAR
  VERB_CONJUGATION
  MULTIPLE_CHOICE_GRAMMAR
  TRANSFORMATION

  // Listening & Writing
  LISTEN_FILL_WORD
  LISTEN_FILL_SENTENCE
  WRITING_RUBRIC

  // Speaking
  SPEAK_FILL_WORD
  SPEAK_FILL_SENTENCE
  SPEAKING

  // Extra game types
  CROSSWORD
  FLASHCARD_3D
  MINIMAL_PAIR
  PICTURE_TO_WORD
}

enum Anex {
  VOCABULARY
  GRAMMAR
  LISTENING_WRITING
  SPEAKING
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

enum PaymentProvider {
  LEMONSQUEEZY
  CHARGILY
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  password                String?
  name                    String
  image                   String?
  role                    Role      @default(STUDENT)
  isVerified              Boolean   @default(false)
  emailVerified           DateTime?
  verificationCode        String?
  verificationCodeExpires DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  educatorProfile  EducatorProfile?
  classMemberships ClassMember[]
  progress         StudentProgress[]
  xp               StudentXP?
  badges           StudentBadge[]
}

model EducatorProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorType          String? // Teacher | Content Creator | Both
  subscriptionPlan     Plan     @default(FREE)
  paymentProvider      PaymentProvider? // NEW: track which payment system
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?
  chargilyCustomerId         String?  // NEW: for future use
  aiGenerationsThisMonth   Int      @default(0)
  aiGenerationsResetAt     DateTime?
  createdAt                DateTime @default(now())

  courses        Course[]
  games          Game[]
  classes        Class[]
  subscriptions  Subscription[]
  wordSets       WordSet[]
}

model Course {
  id            String      @id @default(cuid())
  title         String
  description   String
  language      String
  level         CourseLevel
  coverImage    String?
  isPublished   Boolean     @default(false)
  educatorId    String
  educator      EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lessons   Lesson[]
  sources   CourseSource[]
  games     Game[]
}

model CourseSource {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fileName      String
  fileType      String
  extractedText String   @db.Text
  fileUrl       String?  @db.Text
  uploadedAt    DateTime @default(now())

  @@index([courseId])
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  type      String   @default("text")
  content   String   @default("")
  createdAt DateTime @default(now())

  exerciseSets ExerciseSet[]
}

model ExerciseSet {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  anex        Anex
  language    String
  level       CourseLevel
  items       Json     @default("[]")
  generatedBy String   @default("gemini")
  createdAt   DateTime @default(now())

  games Game[]
}

// ── Portable, game-agnostic content list ──
// A saved list of items ({ word, translation, exampleSentence }) that ANY game
// type can be filled from (via lib/fill-game). Unlike ExerciseSet it is NOT tied
// to a lesson or a single game's fields, so one set is reusable across every game.
model WordSet {
  id             String   @id @default(cuid())
  educatorId     String
  educator       EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  name           String
  language       String   @default("English")
  nativeLanguage String   @default("English")
  level          String   @default("B1")
  contentType    String   @default("words")  // words | phrases | sentences | grammar
  sourceType     String   @default("MANUAL") // MANUAL | AI_TOPIC
  items          Json     @default("[]")      // [{ word, translation, exampleSentence }]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([educatorId])
}

model Game {
  id              String   @id @default(cuid())
  educatorId      String
  educator        EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  title           String
  type            GameType
  courseId        String?
  course          Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  exerciseSetId   String?
  exerciseSet     ExerciseSet? @relation(fields: [exerciseSetId], references: [id])
  settings        Json     @default("{}")
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())

  // AI generation tracking
  generationStatus String @default("manual")  // "manual" | "ready" | "needs_review"
  generationError  String?
  generationRaw    Json?
  version          Int     @default(1)
  previousData     Json?

  assignments   Assignment[]
  progress      StudentProgress[]

  // Type-specific game data (one per game, set by the game type)
  flashcardData        FlashcardData?
  quizData             QuizData?
  crosswordData        CrosswordData?
  verbConjugationData  VerbConjugationData?
  storyData            StoryData?
}

// ── Flashcard pairs (covers FLASHCARD, SYNONYM_ANTONYM, WORD_SCRAMBLE, PICTURE_TO_WORD, FLASHCARD_3D) ──
model FlashcardData {
  id     String   @id @default(cuid())
  gameId String   @unique
  game   Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  pairs FlashcardPair[]
}

model FlashcardPair {
  id               String       @id @default(cuid())
  flashcardDataId  String
  flashcardData    FlashcardData @relation(fields: [flashcardDataId], references: [id], onDelete: Cascade)
  word             String
  translation      String
  exampleSentence  String?
  audioUrl         String?
  imageUrl         String?
  order            Int          @default(0)
}

// ── Quiz questions (covers QUIZ, MULTIPLE_CHOICE_GRAMMAR, ERROR_SPOTTING) ──
model QuizData {
  id     String   @id @default(cuid())
  gameId String   @unique
  game   Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  config Json     @default("{}") // { optionsCount, shuffle, etc. }

  questions Question[]
}

model Question {
  id         String   @id @default(cuid())
  quizDataId String
  quizData   QuizData @relation(fields: [quizDataId], references: [id], onDelete: Cascade)
  prompt     String
  options    Json     // string[]
  correctAnswer String
  explanation   String?
  order         Int     @default(0)
}

// ── Crossword grid ──
model CrosswordData {
  id       String   @id @default(cuid())
  gameId   String   @unique
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gridSize Int      @default(8)
  words    Json     // [{ word, clue, direction: "across"|"down", row, col }]
}

// ── Verb conjugation ──
model VerbConjugationData {
  id       String   @id @default(cuid())
  gameId   String   @unique
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  verb     String
  tense    String
  forms    Json     // { "I": "was", "You": "were", ... }
}

// ── Story builder ──
model StoryData {
  id       String   @id @default(cuid())
  gameId   String   @unique
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  prompt   String
  wordBank Json?    // string[]
  template String?
}

model Class {
  id                String   @id @default(cuid())
  educatorId        String
  educator          EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  name              String
  language          String
  level             CourseLevel
  nativeLanguage    String?  // e.g. "English", "Arabic", "French"
  showNativeSupport Boolean  @default(true)
  inviteCode        String   @unique
  createdAt         DateTime @default(now())

  members     ClassMember[]
  assignments Assignment[]
}

model ClassMember {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([classId, studentId])
}

model Assignment {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  isLive    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model StudentProgress {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  score       Float
  timeTaken   Int
  completedAt DateTime @default(now())
  xpEarned    Int      @default(0)
}

model StudentXP {
  id             String   @id @default(cuid())
  studentId      String   @unique
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalXP        Int      @default(0)
  level          Int      @default(1)
  streak         Int      @default(0)
  lastActiveDate DateTime?
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  iconUrl     String?
  condition   String

  students StudentBadge[]
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([studentId, badgeId])
}

model Subscription {
  id               String   @id @default(cuid())
  educatorId       String
  educator         EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  plan             Plan
  status           SubscriptionStatus @default(ACTIVE)
  paymentProvider  PaymentProvider @default(LEMONSQUEEZY) // NEW
  lemonSqueezyId         String?  @unique
  chargilyCheckoutId     String?  // NEW: last successful Chargily checkout
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())

  @@index([paymentProvider])
  @@index([currentPeriodEnd])
}

model PlatformSettings {
  id              String @id @default("singleton")
  revenueSharePct Float  @default(25)
  promoCodes      Json   @default("[]")
  emailTemplates  Json   @default("{}")
}
