# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, etc.)
# Use the direct connection (port 5432) for Prisma migrations
DATABASE_URL="postgresql://user:password@host:5432/postgres"
# Direct connection for migrations (Supabase: same as DATABASE_URL)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ── Authentication (NextAuth.js) ─────────────────────────
NEXTAUTH_URL="https://education-languages-app.vercel.app/"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_DOMAIN="education-languages-app.vercel.app"
NEXT_PUBLIC_APP_NAME="EduPlay"

# ── AI Generation ────────────────────────────────────────
# Google Gemini — free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Groq — ultra-fast vocabulary generation, get key at https://console.groq.com
GROQ_API_KEY=""

# ── Payments (Lemon Squeezy) ─────────────────────────────
# API key from Settings → API in Lemon Squeezy dashboard
LEMON_SQUEEZY_API_KEY=""
# Store ID from your store URL (e.g. app.lemonsqueezy.com/stores/12345)
LEMON_SQUEEZY_STORE_ID=""
# Webhook signing secret from Settings → Webhooks
LEMON_SQUEEZY_WEBHOOK_SECRET=""

# Variant IDs for subscription plans (create products in LS first)
LS_VARIANT_PRO_MONTHLY=""
LS_VARIANT_PRO_YEARLY=""
LS_VARIANT_ULTIMATE_MONTHLY=""
LS_VARIANT_ULTIMATE_YEARLY=""

# Variant ID for marketplace one-time purchases
LEMON_SQUEEZY_DUMMY_VARIANT_ID=""

# ── Media Uploads (Cloudinary) ───────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="EduPlay <noreply@your-domain.com>"
